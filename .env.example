# Database Connection Settings
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/emergency_db

# Redis Stream Settings
REDIS_URL=redis://localhost:6379/0

# HMAC Authentication Settings (for API security)
HMAC_SECRET=replace-this-with-a-secure-random-secret
MAX_CLOCK_SKEW_SECONDS=300

# Operational Worker Settings
RESPONDER_HEARTBEAT_INTERVAL=10
ACK_TIMEOUT_SECONDS=300
ESCALATION_POLL_INTERVAL=10
DEGRADED_POLL_INTERVAL=5